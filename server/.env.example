NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/stash

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Required only for note attachments. The API still boots without these.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
