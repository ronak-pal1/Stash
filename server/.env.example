NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/stash

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads

# Optional SMTP. In development, reset links are printed in the API log
# and also sent through an Ethereal test inbox when it is reachable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stash <noreply@stash.local>

# Optional Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@stash.local

# Optional S3. Local disk is used when these are empty.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
